// Cursor 与 VS Code 当前共用此快捷键配置
[
    // ============================================================
    // Vim
    // ============================================================

    // 使用 Ctrl+V 开启或关闭 Vim 模式；需要安装 VSCodeVim 扩展
    {
        "key": "ctrl+v",
        "command": "toggleVim",
        "when": "editorTextFocus"
    },


    // ============================================================
    // Cursor Agent
    // ============================================================

    // 使用 Command+I 打开 Cursor Agent；此命令仅在 Cursor 中生效
    {
        "key": "cmd+i",
        "command": "composerMode.agent"
    },


    // ============================================================
    // 命令面板
    // ============================================================

    // 在编辑器的 Vim 普通模式下连续按两次 Space 打开命令面板
    {
        "key": "space space",
        "command": "workbench.action.showCommands",
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },

    // ============================================================
    // 编辑器字体缩放
    // ============================================================

    // 使用 Command+= 增大编辑器字体
    {
        "key": "cmd+=",
        "command": "editor.action.fontZoomIn",
        "when": "editorTextFocus"
    },

    // 使用 Command+- 减小编辑器字体
    {
        "key": "cmd+-",
        "command": "editor.action.fontZoomOut",
        "when": "editorTextFocus"
    },

    // 使用 Command+0 恢复编辑器默认字体大小
    {
        "key": "cmd+0",
        "command": "editor.action.fontZoomReset",
        "when": "editorTextFocus"
    }
]
